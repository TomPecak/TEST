#!/bin/sh
# Launcher of the installed calculator (generated by CMake from scripts/test-ipc-calculator.sh.in).
#
# Starts the service unless one already listens on the socket (a new service would take the socket
# over from the running one), opens the window and stops the service it started when the window
# closes. Options are passed to the window, e.g. --face cyber.

BINDIR="$(dirname "$(readlink -f "$0")")"
SERVICE="$BINDIR/@SERVICE_FROM_BINDIR@"
WINDOW="$BINDIR/test-calculator"
SOCKET="${TEST_IPC_CALCULATOR_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/test-ipc-calculator.sock}"

started=""
if ! ss -xlH src "$SOCKET" 2>/dev/null | grep -q .; then
    "$SERVICE" &
    started=$!
fi

"$WINDOW" "$@"
status=$?

if [ -n "$started" ]; then
    kill "$started" 2>/dev/null
    wait "$started" 2>/dev/null
fi
exit $status
